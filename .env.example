# ====================================================================
# VeriRAG Enterprise Environment Configuration
# ====================================================================

# LLM / AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Enterprise JWT Session Secret
JWT_SECRET=verirag_super_secure_jwt_secret_key_2026_enterprise
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Connection (Default uses built-in SQLite, or PostgreSQL URL)
DATABASE_URL=sqlite:///storage/verirag.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://verirag_user:verirag_pass@localhost:5432/verirag_db

# Storage Directories
STORAGE_DIR=storage
VECTOR_DB_PATH=storage/vector_db
UPLOADS_DIR=storage/uploads
EMPLOYEE_EXCEL_PATH=data/employees/employees.xlsx
DOCUMENTS_DIR=data/documents

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
